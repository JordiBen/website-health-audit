{
  "actorSpecification": 1,
  "name": "website-health-audit",
  "title": "SEO Audit & Domain Checker: DNS Lookup, SSL, DMARC",
  "description": "Bulk SEO audit and domain checker: DNS lookup (A, MX, NS, SPF, DMARC, CAA), SSL certificate expiry, security headers, redirect chains and on-page SEO for a list of domains, with a 0-100 score and a plain-English fix list. $5 per 1,000 sites.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "input",
              "score",
              "issueCount",
              "http.finalUrl",
              "http.status",
              "ssl.daysUntilExpiry",
              "dns.spf",
              "dns.dmarc",
              "securityHeaders.missing",
              "seo.title"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "input": {
                "label": "Target"
              },
              "score": {
                "label": "Score",
                "format": "number"
              },
              "issueCount": {
                "label": "Issues",
                "format": "number"
              },
              "http.finalUrl": {
                "label": "Final URL",
                "format": "link"
              },
              "http.status": {
                "label": "HTTP"
              },
              "ssl.daysUntilExpiry": {
                "label": "SSL days left",
                "format": "number"
              },
              "dns.spf": {
                "label": "SPF"
              },
              "dns.dmarc": {
                "label": "DMARC"
              },
              "securityHeaders.missing": {
                "label": "Missing headers",
                "format": "array"
              },
              "seo.title": {
                "label": "Title"
              }
            }
          }
        }
      }
    }
  }
}
